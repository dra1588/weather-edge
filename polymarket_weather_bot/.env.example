# Safe default: scans and records hypothetical fills only.
MODE=paper
DATABASE_PATH=weatherbot.db
PAPER_BANKROLL_USD=1000
SCAN_INTERVAL_SECONDS=300
CITIES=nyc,chicago,miami,los_angeles,denver

# Signal and execution gates
MIN_EDGE=0.10
MIN_VOLUME_USD=1000
MAX_SPREAD=0.08
MAX_ENTRY_PRICE=0.85
MAX_DAYS_AHEAD=7
KELLY_FRACTION=0.10
MAX_BET_USD=25
MAX_POSITION_PCT=0.02
MAX_DAILY_RISK_USD=50
MAX_CITY_RISK_USD=30
MAX_OPEN_POSITIONS=8

# Live mode requires MODE=live and the CLI flag --confirm-live.
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_SIGNATURE_TYPE=0

